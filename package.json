{
  "name": "bureau",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Bureau — a local-first, Claude-powered job hunting atelier.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c red,yellow \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "selfcheck": "tsx scripts/selfcheck.ts",
    "e2e": "tsx scripts/e2e.ts",
    "ui-smoke": "tsx scripts/ui-smoke.ts",
    "fixtures": "tsx scripts/fixture-server.ts",
    "mcp": "tsx server/api/mcp/stdio.ts",
    "writer:report": "tsx scripts/writer-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "playwright-core": "^1.64.1",
    "sanitize-html": "^2.18.1",
    "undici": "^8.12.3",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
